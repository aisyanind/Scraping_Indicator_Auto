APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEV_DEPLOYMENT_ID/exec
APPS_SCRIPT_TOKEN=CHANGE_ME_DEV_TOKEN
# Kosongkan = pakai folder bundel legacy_indicators/ di dalam repo (default).
# Isi hanya jika ingin memakai folder legacy eksternal.
LEGACY_INDICATORS_PATH=
POLL_SECONDS=10
JOB_TIMEOUT_SECONDS=900
AUTO_CONFIDENCE_THRESHOLD=0.80
REVIEW_CONFIDENCE_THRESHOLD=0.55
# Konkurensi worker (paralel antar-job)
WORKER_CONCURRENCY=5
# Max request simultan per domain sumber (antar-job maupun dalam-job)
PER_DOMAIN_LIMIT=1
# Max panggilan Apps Script bersamaan
APPS_SCRIPT_CONCURRENCY=2
# Max task scraping bersamaan dalam satu job (tahun & sumber)
INNER_CONCURRENCY=3
